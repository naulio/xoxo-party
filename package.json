{
  "name": "xoxo-party",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XOXO PARTY — Projet XX. Gestion de bar temps réel pour soirée privée.",
  "homepage": "https://naulio.github.io/xoxo-party/",
  "scripts": {
    "dev": "node server/index.js --dev",
    "dev:online": "node server/index.js --dev --tunnel",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "deploy": "node scripts/deploy-pages.mjs",
    "start": "node server/index.js",
    "online": "node server/index.js --tunnel",
    "party": "npm run build && npm start",
    "party:online": "npm run build && npm run online"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/outfit": "^5.1.0",
    "cloudflared": "^0.7.1",
    "express": "^4.21.2",
    "framer-motion": "^11.11.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.462.0",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
